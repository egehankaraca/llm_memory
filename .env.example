DATABASE_URL=postgresql+psycopg2:///memory_db
MEMORY_ANALYZER_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_CTX=4096
MEMORY_TIMEZONE=Europe/Istanbul
MEMORY_SERVICE_URL=http://127.0.0.1:8001
MEMORY_SERVICE_TIMEOUT_SECONDS=120
MEMORY_ASYNC_INGESTION=true
MEMORY_OUTBOX_MAX_ATTEMPTS=5
MEMORY_WINDOW_MAX_MESSAGES=10
MEMORY_WINDOW_MAX_TOKENS=2000
MEMORY_CONVERSATION_TTL_HOURS=24
MEMORY_TEMPORARY_MAX_ITEMS=20
MEMORY_TEMPORARY_MAX_TOKENS=1500
MEMORY_TEMPORARY_TTL_MINUTES=60
MEMORY_EPISODE_MAX_ITEMS=10
MEMORY_EPISODE_MAX_TOKENS=1000
MEMORY_CONSOLIDATION_MAX_FACTS=50
MEMORY_PROFILE_MAX_FACTS=20
MEMORY_PROFILE_MAX_TOKENS=1500
MEMORY_PROFILE_PINNED_CATEGORIES=communication,accessibility,emergency_contact
MEMORY_SEMANTIC_RETRY=false
MEMORY_PROFILE_SEMANTIC_PROVIDER=ollama
MEMORY_PROFILE_EMBEDDING_MODEL=embeddinggemma:latest
MEMORY_PROFILE_EMBEDDING_TIMEOUT_SECONDS=10
MEMORY_PROFILE_EMBEDDING_CACHE_SIZE=256
MEMORY_PROFILE_SEMANTIC_MAX_CANDIDATES=100
MEMORY_PROFILE_SEMANTIC_MIN_SIMILARITY=0.40
MEMORY_PROFILE_VECTOR_TOP_K=20
MEMORY_EMBEDDING_MAX_ATTEMPTS=5
CHAT_OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_OLLAMA_MODEL=qwen3:8b
CHAT_OLLAMA_TIMEOUT_SECONDS=120
CHAT_OLLAMA_NUM_CTX=4096
CHAT_OLLAMA_NUM_PREDICT=512
CHAT_OLLAMA_KEEP_ALIVE=5m
